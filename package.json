{
  "name": "yandex-messenger",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=12.0.0"
  },
  "lint-staged": {
    "*.ts": "npx tsc --noEmit",
    "*.{js,jsx,ts,tsx}": "npx eslint",
    "*.{js,jsx,ts,tsx,html,css}": "npx prettier --check"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "start": "vite build && node server.cjs",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.ts",
    "lint:style": "stylelint \"**/*.scss\"",
    "lint:fix": "eslint src --ext .js,.ts --fix",
    "lint:style:fix": "stylelint \"**/*.scss\" --fix",
    "test": "jest",
    "prepare": "husky",
    "pre-commit": "npm run build && npm run test && npm run lint && npm run lint:style"
  },
  "dependencies": {
    "express": "4.21.2",
    "handlebars": "4.7.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "7.1.0",
    "@typescript-eslint/parser": "7.1.0",
    "chai": "^5.2.0",
    "eslint": "8.57.0",
    "eslint-config-google": "0.14.0",
    "eslint-config-prettier": "10.1.1",
    "eslint-plugin-prettier": "5.2.3",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^16.0.0",
    "mocha": "^11.2.2",
    "saas": "1.0.0",
    "sass-embedded": "1.85.1",
    "stylelint": "^16.19.1",
    "stylelint-config-standard": "36.0.0",
    "stylelint-config-standard-scss": "14.0.0",
    "stylelint-scss": "6.11.1",
    "ts-jest": "^29.3.3",
    "ts-node": "^10.9.2",
    "typescript": "5.7.2",
    "uuid": "11.1.0",
    "vite": "6.2.0",
    "vite-plugin-handlebars": "1.5.0"
  }
}
